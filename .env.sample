# Copy to .env and fill in your values.
#   cp .env.sample .env

# PostgreSQL (postgres service in docker-compose)
POSTGRES_DB=polymarket
POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword

# Database URL (localhost outside Docker, postgres inside Docker)
DATABASE_URL=postgresql+asyncpg://app:devpassword@localhost:5432/polymarket

# Discord webhook for smart money alerts (empty = disabled)
DISCORD_WEBHOOK_URL=

# Alert poll interval (seconds)
ALERT_POLL_INTERVAL_SECONDS=10

# Mage container memory limit (e.g. 4g, 8g; empty = no limit)
MAGE_MEM_LIMIT=8g

# Target wallets to discover
TARGET_WALLET_COUNT=1000

# Force full sync (true/1/yes) — bypasses incremental filter
# FULL_SYNC=false

# Verification thresholds (min rows after ETL)
VERIFY_MIN_WALLETS=500
VERIFY_MIN_TRADES=25000
VERIFY_MIN_WALLET_ANALYTICS=2
VERIFY_MIN_RANKING_SNAPSHOTS=5
