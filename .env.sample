# PostgreSQL
POSTGRES_DB=polymarket
POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword

# Docker memory limit for the mage container (e.g. 4g, 6g, 8g)
# Prevents Mage from seeing the full Docker VM memory and hitting the 95% threshold.
# Set to empty or comment out to remove the limit.
MAGE_MEM_LIMIT=8g
