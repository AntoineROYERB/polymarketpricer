# PostgreSQL
POSTGRES_DB=polymarket
POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword

# Docker memory limit for the mage container (e.g. 4g, 6g, 8g)
# Prevents Mage from seeing the full Docker VM memory and hitting the 95% threshold.
# Set to empty or comment out to remove the limit.
MAGE_MEM_LIMIT=8g
DISCORD_WEBHOOK_URL=

# Wallet discovery — target number of wallets to discover
TARGET_WALLET_COUNT=1000

# Verification thresholds (minimum rows expected after pipelines)
VERIFY_MIN_WALLETS=500
VERIFY_MIN_TRADES=25000
VERIFY_MIN_WALLET_ANALYTICS=2
VERIFY_MIN_RANKING_SNAPSHOTS=5